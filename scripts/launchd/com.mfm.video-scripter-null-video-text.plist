<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  06:00 ET: one bounded, resumable pass of the null-out (scripts/null-video-text-tonight.ts →
  scripts/null-video-text.ts). Clears videos.<col> for every row whose video_text copy is proved
  byte-equal in the same statement, for the columns in CLEARED_COLUMNS (lib/app/video-text-move.ts;
  llm_summary as of 2026-09-26). Rows not yet moved are left for a later night.

  2026-09-14..26 this job waited for ZERO unmoved videos corpus-wide by 05:48 — while starting at
  06:00 and while ingest added 3-30 K a day — and stood down 12 nights of 12. There is no such gate
  now (lib/app/null-out-gate.ts). Each run writes an outcome to logs/job-outcomes.jsonl;
  scripts/storage-guard.ts alerts if three runs in a row did nothing with text still held.

  The old `--deadline 05:48` argument is accepted and ignored, so an installed copy of the previous
  plist keeps working. Refuses while the mirror trigger exists (it would null video_text too).

  Install:
    cp scripts/launchd/com.mfm.video-scripter-null-video-text.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$UID/com.mfm.video-scripter-null-video-text 2>/dev/null
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.mfm.video-scripter-null-video-text.plist
  Rehearse:
    npx tsx scripts/null-video-text.ts --dry-run
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.mfm.video-scripter-null-video-text</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>npx tsx scripts/null-video-text-tonight.ts</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter/logs/null-video-text-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter/logs/null-video-text-launchd.err.log</string>
</dict></plist>
