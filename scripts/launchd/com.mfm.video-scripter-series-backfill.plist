<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly at 04:00 ET: rebuild every video's series file, including the readings Postgres has
  already thinned away (--with-archive reads them back out of the day-partitioned parquet
  archive, lib/readings/archive.ts).

  This is the slow, complete pass. The ten-minute drain job keeps the files current; this one
  repairs anything the queue missed, and folds in each night's newly archived days so the files
  keep the full history after Postgres has been thinned down to serving resolution.

  It runs AFTER the 02:30 archive-and-thin job for exactly that reason: at 04:00 the previous
  day's parquet has been written and verified, so a video whose Postgres rows were thinned at
  02:30 has them back in its series file by 04:00.

  It refuses to start while anything has been running in Postgres for over two minutes.

  Install:
    cp scripts/launchd/com.mfm.video-scripter-series-backfill.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.mfm.video-scripter-series-backfill.plist

  First full backfill by hand, in pieces, so it can be watched:
    npx tsx scripts/rebuild-series.ts --all --limit 5000 --with-archive
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.mfm.video-scripter-series-backfill</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>npx tsx scripts/rebuild-series.ts --all --with-archive</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter/logs/series-backfill-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter/logs/series-backfill-launchd.err.log</string>
</dict></plist>
