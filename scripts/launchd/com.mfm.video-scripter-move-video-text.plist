<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  05:30 ET nightly: copy description / metadata / llm_summary into video_text for any video that
  has no side row yet (scripts/move-video-text.ts). It COPIES; nothing is nulled here.

  Since 2026-09-26 ingest writes the side row at insert (lib/app/video-text.ts videoInsertSql), so
  this pass only catches rows created by legacy writers (manual API routes). It walks the whole
  primary key in bounded windows: the previous `limit 2000` search walked the entire key space once
  the work was sparse and was killed by the statement timeout (57014) on 2026-09-15..26. A full pass
  measured 79 s (dry run, 1,185,859 keys, window 5,000). Records an outcome in logs/job-outcomes.jsonl.

  Install / refresh:
    cp scripts/launchd/com.mfm.video-scripter-move-video-text.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$UID/com.mfm.video-scripter-move-video-text 2>/dev/null
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.mfm.video-scripter-move-video-text.plist
  Rehearse:
    npx tsx scripts/move-video-text.ts --dry-run
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.mfm.video-scripter-move-video-text</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>npx tsx scripts/move-video-text.ts --batch 5000 --sleep-ms 100 --max-seconds 1200</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter/logs/move-video-text-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/brandoncullum/video-scripter-v2/video-scripter/logs/move-video-text-launchd.err.log</string>
</dict></plist>
