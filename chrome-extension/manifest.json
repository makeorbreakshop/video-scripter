{
  "manifest_version": 3,
  "name": "Channel Ingest (personal)",
  "version": "1.5.0",
  "description": "Click to ingest YouTube channels/videos into the video-scripter tracker; optional passive logging of what you watch.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://mhzwrynnfphlxqcqytrj.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Channel Ingest"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}