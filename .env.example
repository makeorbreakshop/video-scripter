# Supabase Configuration
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# YouTube Data API Configuration
# Get this from Google Cloud Console -> APIs & Services -> Credentials
# Make sure to enable YouTube Data API v3 in your project
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth Configuration
# For accessing private YouTube data (playlists, analytics, etc.)
# Create OAuth 2.0 Client ID in Google Cloud Console -> Credentials
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth-callback

# OpenAI API Configuration
# Get this from OpenAI Dashboard -> API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration (Optional)
# Get this from Anthropic Dashboard -> API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
# These are used for vector database operations
# Get these from your Supabase project settings -> Database
DATABASE_URL=your_database_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application Settings
# These can be left as default values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Clerk (auth gate for /admin, /dashboard and their API routes)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Dev/prod account sync
# Dev and prod share one database; Clerk's test and live instances mint different
# clerk_ids, so the same person owns one app_users row per instance.
# The two rows, for `npm run sync:app-user` (mirror prod's follows into the dev row):
CS_PROD_CLERK_ID=
CS_DEV_CLERK_ID=
# Dev-only. Set this and a local session reads AND WRITES the named row directly —
# the same account, not a copy. Leave unset for normal local development.
# CS_DEV_AS_CLERK_ID=
# Dev-only screenshot preview (cs_preview cookie). Prefer the clerk_id: email is not
# unique in app_users.
CS_PREVIEW_TOKEN=
CS_PREVIEW_CLERK_ID=

# Encrypts stored OAuth refresh tokens at rest (lib/app/crypto.ts).
# Generate with: npx tsx scripts/gen-key.ts
TOKEN_ENCRYPTION_KEY=
